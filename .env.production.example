# Production VM only. Keep the real configuration in
# /opt/employee-shipment-tracker/state/application.env; never commit it.
APP_NAME=Employee Shipment Tracker

# PostgreSQL runs on the same VM and accepts local socket connections only.
DATABASE_URL=postgresql+psycopg:///employee_shipments

JWT_SECRET_KEY=replace-with-a-long-random-production-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60
JWT_COOKIE_SECURE=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

RAJAONGKIR_MOCK=false
RAJAONGKIR_API_KEY=replace-with-rajaongkir-api-key
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1

NOMINATIM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
GEOCODER_USER_AGENT=employee-shipment-tracker-production/1.0
